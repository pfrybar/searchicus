{
  "name": "@searchicus/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, the SearchEngine plugin interface, the engine registry, and browser-backed engines for searchicus.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser.js",
    "./ranking": "./dist/ranking.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "defuddle": "0.19.3",
    "linkedom": "0.18.13",
    "playwright": "1.62.1",
    "stemmer": "2.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "vitest": "5.0.0"
  }
}
