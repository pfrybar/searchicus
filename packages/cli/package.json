{
  "name": "@searchicus/cli",
  "version": "0.1.0",
  "private": true,
  "description": "searchicus command-line interface.",
  "type": "module",
  "bin": {
    "searchicus": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@searchicus/core": "0.1.0",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "vitest": "5.0.0"
  }
}
