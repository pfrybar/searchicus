{
  "name": "@searchicus/cli",
  "version": "0.1.0",
  "private": true,
  "description": "searchicus command-line interface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pfrybar/searchicus.git",
    "directory": "packages/cli"
  },
  "bin": {
    "searchicus": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "npm run build -w @searchicus/core",
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run build -w @searchicus/core",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build -w @searchicus/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run build -w @searchicus/core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@searchicus/core": "0.1.0",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "vitest": "5.0.0"
  }
}
