{
  "name": "@searchicus/ui",
  "version": "0.1.0",
  "private": true,
  "description": "searchicus web UI — a simple search page over the HTTP API.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pfrybar/searchicus.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build -w @searchicus/core",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run build -w @searchicus/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run build -w @searchicus/core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@searchicus/core": "0.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
